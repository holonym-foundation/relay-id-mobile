{
  "cli": {
    "version": ">= 16.20.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "staging": {
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "RELAYID_APP_VARIANT": "staging",
        "EXPO_PUBLIC_WAAP_ENVIRONMENT": "staging",
        "EXPO_PUBLIC_STELLAR_NATIVE_NETWORK": "TESTNET"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
